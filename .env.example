# Default is bearer authentication. Generate a long random secret; never commit the real value.
REMOTE_CODING_AGENT_AUTH_MODE=bearer
MCP_AUTH_TOKEN=replace-with-a-long-random-secret

# Server settings
REMOTE_CODING_AGENT_HOST=127.0.0.1
REMOTE_CODING_AGENT_PORT=8000

# Execution settings (used by later implementation tasks)
REMOTE_CODING_AGENT_WORKSPACE=./workspace
REMOTE_CODING_AGENT_DEFAULT_TIMEOUT_SECONDS=30
REMOTE_CODING_AGENT_MAX_TIMEOUT_SECONDS=300
REMOTE_CODING_AGENT_MAX_OUTPUT_CHARS=20000
